---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero';
import StatsBanner from '../components/StatsBanner';
import CallRecordings from '../components/CallRecordings';
import RankEcosystem from '../components/RankEcosystem';
import Pricing from '../components/Pricing';
import VisibilityPillars from '../components/VisibilityPillars';
// import PremiumFeatures from '../components/PremiumFeatures';
import HowItWorks from '../components/HowItWorks';
import Integrations from '../components/Integrations';
import Testimonials from '../components/Testimonials';
import FAQ from '../components/FAQ';
import BookACall from '../components/BookACall';
import ContentPerformance from '../components/ContentPerformance';
import TryItYourself from '../components/TryItYourself';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Restoration AI - Automated Receptionist & Dispatch',
  serviceType: 'AI Receptionist & Automation',
  provider: {
    '@type': 'SoftwareApplication',
    name: 'Restoration AI',
  },
  description:
    'AI receptionist and automated dispatch software tailored specifically for the restoration industry. Never miss a call. Never lose a job.',
  areaServed: 'Worldwide',
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Can I keep my current phone number?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, you have two simple options. You can instantly generate a new local or toll-free number within our dashboard, or you can simply forward your existing business number directly to our AI routing system. There is no downtime.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does it integrate with Xactimate / JobNimbus?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Absolutely. Restoration AI features native integrations via standard webhooks that sync seamlessly with Xactimate, JobNimbus, Albiware, and Workiz. New Estimates trigger direct entry into your CRM as soon as the call finishes.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does it handle Spanish-speaking callers?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The AI receptionist speaks in over 42 different languages with native fluency. It instantly detects the caller\'s spoken language and autonomously pivots to converse natively, without any prompt needed from the caller.',
      },
    },
  ],
};
---

<MainLayout jsonLd={[serviceJsonLd, faqJsonLd]}>
  <Hero client:load />
  <StatsBanner client:idle />
  <div class="relative w-full bg-[#fafbfe] overflow-x-clip">
    <!-- Hero-style page background: grid + soft blue edge glow -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background-image: linear-gradient(#e2e8f0 1px, transparent 1px), linear-gradient(90deg, #e2e8f0 1px, transparent 1px); background-size: 100px 100px; background-position: center top; opacity: 0.5; mask-image: linear-gradient(90deg, black 0%, rgba(0,0,0,0.35) 30%, rgba(0,0,0,0.35) 70%, black 100%); -webkit-mask-image: linear-gradient(90deg, black 0%, rgba(0,0,0,0.35) 30%, rgba(0,0,0,0.35) 70%, black 100%);"
    ></div>
    <div class="hidden md:block absolute inset-y-0 left-0 w-[500px] bg-blue-500/15 blur-[160px] pointer-events-none -translate-x-1/2"></div>
    <div class="hidden md:block absolute inset-y-0 right-0 w-[500px] bg-blue-500/15 blur-[160px] pointer-events-none translate-x-1/2"></div>
    <RankEcosystem client:visible />
    <CallRecordings client:visible />
    <HowItWorks client:visible />
    <VisibilityPillars client:visible />
    {/* <PremiumFeatures client:visible /> */}
    <ContentPerformance client:visible />
    <Testimonials client:visible />
    <TryItYourself client:visible />
    <Integrations client:visible />
    <FAQ client:visible />
    <Pricing client:visible />
    <BookACall client:visible />
  </div>
</MainLayout>
